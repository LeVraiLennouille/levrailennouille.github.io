---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign entries = site.html_pages | concat: site.documents -%}
{%- for p in entries -%}
  {%- if p.sitemap == false or p.url == '/404.html' -%}{%- continue -%}{%- endif %}
  <url>
    <loc>{{ site.url }}{{ p.url | replace: 'index.html', '' | replace: '.html', '' }}</loc>
    {%- if p.last_modified_at %}
    <lastmod>{{ p.last_modified_at | date_to_xmlschema }}</lastmod>
    {%- endif %}
  </url>
{%- endfor %}
</urlset>